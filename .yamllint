---
extends: default

ignore: |
  .github/workflows/*.yml

rules:
  line-length:
    max: 120

  indentation:
    spaces: 2

  trailing-spaces: enable

  document-start: disable

  comments:
    min-spaces-from-content: 1

  comments-indentation: false

  braces:
    max-spaces-inside: 1

  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
